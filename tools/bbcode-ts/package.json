{
  "name": "nga-bbcode-ts",
  "version": "0.1.0",
  "private": true,
  "description": "NGA BBCode 解析器 TS 镜像：以 Node 环境验证解析/渲染逻辑，再机械同步回 ArkTS",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "snapshot": "npm run build && node dist/scripts/gen-snapshot.js",
    "inspect:json": "node scripts/fetch-thread-json.mjs",
    "inspect:html": "npm run build && node scripts/inspect-thread-html.mjs",
    "compare:official": "npm run build && node dist/scripts/compare-official.js",
    "compare:html-json": "npm run build && node dist/scripts/compare-html-json.js",
    "fetch:app-pair": "node scripts/fetch-thread-app-pair.mjs",
    "compare:app-html-json": "npm run build && node dist/scripts/compare-html-json.js --suite=app",
    "sync": "node scripts/sync-to-ets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
