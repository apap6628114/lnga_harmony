07,"attachs":{"0":{"attachurl":"mon_202608/03/k2Q81-97rkXrT6wSk0-zk.mp4","size":2664,"type":"zip","subid":0,"url_utf8_org_name":"a7be0c963ea5ee3d9ab2f9cdb56c0bee%2emp4","dscp":"","path":"mon_202608/03","name":"k2Q81-97rkXrT6wSk0-zk.mp4","ext":"mp4","thumb":248,"hash":""}},"from_client":"0 /","postdatetimestamp":1785760408},"1":{"pid":877312291,"fid":722,"tid":47307683,"authorid":62655400,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-03 20:44","subject":"","alterinfo":"","content":"这个真的是可怕","lou":1,"content_length":14,"from_client":"8 Android","postdatetimestamp":1785761067},"2":{"pid":877312797,"fid":722,"tid":47307683,"authorid":36913466,"type":0,"score":13,"score_2":0,"recommend":0,"postdate":"2026-08-03 20:51","subject":"","alterinfo":"","content":"开放系统是这样的，厂家也管不了<br/>以前这种情况只能考虑苹果，现在加个纯血鸿蒙勉强也还行，把应用商店锁死就好了","lou":2,"content_length":104,"from_client":"8 Android","postdatetimestamp":1785761480},"3":{"pid":877313269,"fid":722,"tid":47307683,"authorid":60457805,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-03 20:57","subject":"","alterinfo":"","content":"这种APP一般都会拿无障碍权限吧，记得清一下","lou":3,"content_length":41,"from_client":"0 /","postdatetimestamp":1785761862},"4":{"pid":877314785,"fid":722,"tid":47307683,"authorid":42545764,"type":0,"score":3,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:16","subject":"","alterinfo":"","content":"[s:ac:哭笑]捉个虫，不是P40，看着像nova5或者同系<br/><br/>现在各家的安卓系统能限制安装app，所以问题不大","lou":4,"content_length":79,"from_client":"0 /","postdatetimestamp":1785763014},"5":{"pid":877315501,"fid":722,"tid":47307683,"authorid":61964738,"type":0,"score":10,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:25","subject":"","alterinfo":"[E1785763925 0 0]\t","content":"[s:a2:那个…]想多了，现代Android只有Play商店和第一方应用市场能静默安装APP，其他任何渠道安装APP都强制要求用户手动确认，没有任何方法能授予其他应用静默安装APP的权限，鉴于老人家应该不太可能闲得没事装个Play商店玩，我认为你这种情况有两个可能性，其一是华为应用商店上架了这个病毒APP，如果是这个情况，我相信你能搞明白这是华为的问题还是Android的问题，[b]但我认为这个情况其实不太可能[/b]，其二是老人家忘了自己同意过安装或者根本不理解同意安装的概念，这种情况你觉得换iOS或鸿蒙就有用吗？老人家在Android上不理解什么叫同意安装，换了iOS或鸿蒙就能理解了？<br/>怀疑没清除干净也没必要，设置-应用程序管理里找不到的APP就是清除干净了，除了已下载的不可执行文件以外，不可能有任何残留[s:a2:那个…]<br/><br/>如果你想避免这种情况，应该做的是去设置里开启“仅允许安装来自应用商店的应用程序”，当然啦，如果你这么做了之后还是出现类似的情况，那就代表我说的“不太可能”的可能性是真的了[s:a2:那个…]","lou":5,"content_length":793,"from_client":"0 /","postdatetimestamp":1785763550},"6":{"pid":877316252,"fid":722,"tid":47307683,"authorid":41415145,"type":0,"score":10,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:35","subject":"","alterinfo":"","content":"大部份都是快应用的锅，还有浏览器<br/>想办法把原来的浏览器停用或者删了，装VIA就没事了<br/>很奇怪的是这些大数据还能检测到使用者的年龄<br/>我也在用安卓机，还是臭名昭著的荣耀，但是用起来就是不会像父母那样，牛皮藓贴满脸","lou":6,"content_length":199,"from_client":"0 /","postdatetimestamp":1785764158},"7":{"pid":877316771,"fid":722,"tid":47307683,"authorid":18156092,"type":0,"score":4,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:43","subject":"","alterinfo":"","content":"[quote][pid=877315501,47307683,1]Reply[/pid] [b]Post by [uid=61964738]DELPHINIVM[/uid] (2026-08-03 21:25):[/b]<br/><br/>[s:a2:那个…]想多了，现代Android只有Play商店和第一方应用市场能静默安装APP，其他任何渠道安装APP都强制要求用户手动确认，没有任何方法能授予其他应用静默安装APP的权限，你这种情况有两个可能性，其一是华为应用商店上架了这个病毒APP，如果是这个情况，我相信你能搞明白这是华为的问题还是Android的问题，[b]但我认为这个情况其实不太可能[/b]，其二是老人家忘了自己同意过安装或者根本不理解同意安装的概念，这种情况你觉得换iOS或鸿蒙就有用吗？老人家在Android上不理解什[/quote]<br/><br/>流氓软件就俩来源，应用商店或安装包<br/><br/>国产的第一方应用商店不干净，play商店好的多<br/><br/>ios是完全不允许绕过应用商店安装的，安卓只要后台下载了流氓软件.apk再诱导用户点同意安装就行<br/><br/>有很多流氓软件是老人被诱导了，主动装的，只有从源头把流氓软件的存在掐死才管用<br/><br/>最适合老人的系统就是ios，鸿蒙我没用过但绝对比安卓好的多","lou":7,"content_length":301,"from_client":"8 Android","reply_to":877315501,"postdatetimestamp":1785764583},"8":{"pid":877316799,"fid":722,"tid":47307683,"authorid":64943146,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:43","subject":"","alterinfo":"","content":"不贪心下那些非主流充电啊，散步啊，清理垃圾领现金的APP没见过这种广告。","lou":8,"content_length":69,"from_client":"100 /","postdatetimestamp":1785764611},"9":{"pid":877316984,"fid":722,"tid":47307683,"authorid":63680690,"type":0,"score":3,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:46","subject":"","alterinfo":"","content":"安卓用你潭关了安装权限都能给我安装番茄，别说那些流氓APP了，[s:ac:偷笑]","lou":9,"content_length":57,"from_client":"7 iOS","postdatetimestamp":1785764774},"10":{"pid":877317130,"fid":722,"tid":47307683,"authorid":63680690,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-03 21:47","subject":"","alterinfo":"","content":"[b]Reply to [pid=877316799,47307683,1]Reply[/pid] Post by [uid=64943146]2023张飞30斤[/uid] (2026-08-03 21:43)[/b]<br/><br/>你潭跳转广告就能安装番茄，啥也没点，就那个抖动跳转广告[s:a2:大哭]","lou":10,"content_length":87,"from_client":"7 iOS","reply_to":877316799,"postdatetimestamp":1785764874},"11":{"pid":877353797,"fid":722,"tid":47307683,"authorid":41623994,"type":0,"score":2,"score_2":0,"recommend":0,"postdate":"2026-08-04 10:35","subject":"","alterinfo":"","content":"[s:a2:大哭]有没有人懂得怎么把快应用删了啊","lou":11,"content_length":28,"from_client":"8 Android","postdatetimestamp":1785810943},"12":{"pid":877356657,"fid":722,"tid":47307683,"authorid":62305029,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-04 10:56","subject":"","alterinfo":"","content":"图里这个不是p40.p40是左上角双摄。<br/>nova5是居中水滴单摄。<br/><br/>搜了ai和pdd确认是2018年发布的nova4。","lou":12,"content_length":90,"from_client":"0 /","postdatetimestamp":1785812175},"13":{"pid":877358653,"fid":722,"tid":47307683,"authorid":62305029,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-04 11:10","subject":"","alterinfo":"","content":"[b]Reply to [pid=877316984,47307683,1]Reply[/pid] Post by [uid=63680690]叶雨声烦3[/uid] (2026-08-03 21:46)[/b]我不太确定，但你潭好像不是自己调起安装程序，而是[b]跳转应用商店[/b]","lou":13,"content_length":88,"reply_to":877316984,"from_client":"0 /","postdatetimestamp":1785813053},"14":{"pid":877385760,"fid":722,"tid":47307683,"authorid":33858855,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-04 15:26","subject":"","alterinfo":"","content":"[s:ac:茶]事实就是，这些软件跳出弹框让老人点同意，老人根本就不会思考直接同意，所以老人才会说不知道不清楚，因为他同意的时候本来大脑就是放空的。","lou":14,"content_length":130,"from_client":"0 /","postdatetimestamp":1785828402},"15":{"pid":877396607,"fid":722,"tid":47307683,"authorid":61157738,"type":0,"score":2,"score_2":0,"recommend":0,"postdate":"2026-08-04 16:59","subject":"","alterinfo":"","content":"[b]Reply to [pid=877312797,47307683,1]Reply[/pid] Post by [uid=36913466]一地的玻璃渣[/uid] (2026-08-03 20:51)[/b]<br/><br/>和开放系统有什么关系？[s:ac:呆] <br/><br/>Android原生系统安装APP是需要用户手动点击同意的。这种点击链接就会后台安装，小概率是黑客使用0Day，大概率是无良推广公司调用的手机厂商的官方快应用API安装。<br/><br/>靠个别消费者是无法改变的，需要相关部门去协调各家厂商严格管理快应用。","lou":15,"content_length":274,"reply_to":877312797,"from_client":"0 /","postdatetimestamp":1785833984},"16":{"pid":877398047,"fid":722,"tid":47307683,"authorid":61157738,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-04 17:11","subject":"","alterinfo":"","content":"[b]Reply to [pid=877353797,47307683,1]Reply[/pid] Post by [uid=41623994]Kewya[/uid] (2026-08-04 10:35)[/b]<br/><br/>老系统能通过ADB删除，新系统好像把快应用改成系统级权限了，不能直接删除。你可以尝试使用冰箱等APP冰冻它，或者想办法禁止快应用联网。例如使用系统联网设置，或者第三方防火墙。防火墙还可以只让白名单的APP联网。<br/><br/>上面部分还不行，可以考虑路由器上禁止快应用的域名。<br/><br/>喜欢折腾还可以ROOT删除或者BL刷第三方开源系统。<br/><br/>一步到位换苹果手机。","lou":16,"content_length":345,"reply_to":877353797,"from_client":"0 /","postdatetimestamp":1785834715},"17":{"pid":877398767,"fid":722,"tid":47307683,"authorid":42171600,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-04 17:18","subject":"","alterinfo":"","content":"我妈手机前段时间也这样，我找半天才找到一个xx天气，桌面上没有，看启动记录才发现的，也没开无障碍，就是一直弹广告，而且肯定是应用商店里下的，我妈不会从其他地方安装，这些软件真的缺了大德了","lou":17,"content_length":184,"from_client":"0 /","postdatetimestamp":1785835093},"18":{"pid":877401757,"fid":722,"tid":47307683,"authorid":42204512,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-04 17:44","subject":"","alterinfo":"[E1785836785 0 0]\t","content":"说白了还是点了同意安装，不如教教老年人怎么用手机","lou":18,"content_length":48,"from_client":"8 Android","postdatetimestamp":1785836675},"19":{"pid":877458305,"fid":722,"tid":47307683,"authorid":62285947,"type":0,"score":0,"score_2":0,"recommend":0,"postdate":"2026-08-05 10:16","subject":"","alterinfo":"","content":"这种病毒app基本全是软件商店静默安装。都是短视频平台广告推流什么需要清理垃圾，病毒的广告，老年人一点就开始自动安装app。有的甚至都没有桌面图标<br/>最大的垃圾制造者就是这些国内厂商的软件商店。有一个算一个，都不是什么好东西","lou":19,"content_length":214,"from_client":"0 /","postdatetimestamp":1785896215}},"__T":{"fid":722,"tid":47307683,"topic_misc":"","subject":"这就是为什么一直说不能给老人用安卓机，特别是农村老人，病毒app都不知道怎么中招的","locked":0,"recommend":0,"quote_to":"","quote_from":0,"type":8192,"replies":40,"authorid":2276343,"postdate":1785760408,"lastpost":1786265167,"jdata":"","author":"懲戒","lastposter":"水是云的故乡","digest":0,"lastmodify":1786268488,"tpid":0,"post_misc_var":{"content_length":407,"fid":722,"attachs":{"0":{"attachurl":"mon_202608/03/k2Q81-97rkXrT6wSk0-zk.mp4","size":2664,"type":"zip","subid":0,"url_utf8_org_name":"a7be0c963ea5ee3d9ab2f9cdb56c0bee%2emp4","dscp":"","path":"mon_202608/03","name":"k2Q81-97rkXrT6wSk0-zk.mp4","ext":"mp4","thumb":248,"hash":""}}},"this_visit_rows":41},"__F":{"name":"手机研究所"},"__R__ROWS":20,"__R__ROWS_PAGE":20,"__ROWS":41,"__PAGE":1},"encode":"GBK","time":1786291326}